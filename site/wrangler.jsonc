{
  "$schema": "./node_modules/wrangler/config-schema.json",
  // Existing production Worker. Renaming this creates/targets a DIFFERENT Worker
  // and therefore a different *.workers.dev URL — do not change without deciding
  // what happens to https://mute-feather-417a.brodie-dye-11.workers.dev
  "name": "mute-feather-417a",
  "compatibility_date": "2026-07-25",
  // Static-assets-only Worker: no "main" script, Astro's build output is served directly.
  "assets": {
    "directory": "./dist"
  }
}
