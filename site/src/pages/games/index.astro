---
import SiteLayout from '../../layouts/SiteLayout.astro';

const games = [
  {
    slug: 'd44a',
    number: '01',
    title: 'Run 1: Retributive Germany–Italy',
    frameworks: 'Utilitarian England–Austria · Deontological France–Russia · Retributive Germany–Italy',
  },
  {
    slug: 'd44b',
    number: '02',
    title: 'Run 2: Retributive France–Russia',
    frameworks: 'Deontological England–Austria · Retributive France–Russia · Utilitarian Germany–Italy',
  },
  {
    slug: 'd44c',
    number: '03',
    title: 'Run 3: Retributive England–Austria',
    frameworks: 'Retributive England–Austria · Utilitarian France–Russia · Deontological Germany–Italy',
  },
];
---
<SiteLayout title="Explore games — Exploitability of Moral Frameworks in LLM Negotiation">
  <section class="collection-shell">
    <p class="eyebrow">Interactive record</p>
    <h1>Explore the games</h1>
    <p class="deck">Three complete five-year rotations. Each replay contains the public board states, negotiations, constitutional arguments, rulings and resolved orders.</p>
    <div class="game-list">
      {games.map((game) => (
        <a class="game-card" href={`/games/${game.slug}/`}>
          <span class="game-number">{game.number}</span>
          <div>
            <p class="eyebrow">Five-year transparent run</p>
            <h2>{game.title}</h2>
            <p>{game.frameworks}</p>
          </div>
          <span aria-hidden="true">→</span>
        </a>
      ))}
    </div>
  </section>
</SiteLayout>
