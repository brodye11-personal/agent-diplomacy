---
import SiteLayout from '../../layouts/SiteLayout.astro';
import Viewer from '../../components/Viewer';

export function getStaticPaths() {
  return ['d44a', 'd44b', 'd44c'].map((slug) => ({ params: { slug } }));
}

const { slug } = Astro.params;
---
<SiteLayout title="Game explorer — Exploitability of Moral Frameworks in LLM Negotiation">
  <Viewer slug={slug!} client:load />
</SiteLayout>
