---
import SiteLayout from '../../layouts/SiteLayout.astro';
import EssayFinal from '../../content/essay_final.md';
import EssayAppendix from '../../content/essay_appendix.md';
import ArticleEvidence from '../../components/ArticleEvidence';
import ArticleStructures from '../../components/ArticleStructures';
---
<SiteLayout title="Exploitability of Moral Frameworks in LLM Negotiation">
  <article class="article-shell essay">
    <p class="meta">By Brodie Dye</p>
    <EssayFinal />
  </article>
  <details class="appendix-disclosure essay" id="appendix-a-experiment-design">
    <summary><span>Reference material</span><strong>Appendix A: Experiment design</strong></summary>
    <div class="appendix-body"><EssayAppendix /></div>
  </details>
  <ArticleEvidence client:load />
  <ArticleStructures client:load />
  <script is:inline>
    (() => {
      const revealAppendix = () => {
        if (location.hash !== '#appendix-a-experiment-design') return;
        const appendix = document.querySelector('#appendix-a-experiment-design');
        if (appendix) appendix.open = true;
      };
      revealAppendix();
      window.addEventListener('hashchange', revealAppendix);
    })();
  </script>
</SiteLayout>
